<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main_activity.news_page.official_coms.OfficialFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/officialRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="5dp"
        tools:listitem="@layout/adapters_official_item"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:contentDescription="Add official docs"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:id="@+id/addOfficialDocs"
        android:clickable="true"
        android:src="@drawable/add_official_docs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="10dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>