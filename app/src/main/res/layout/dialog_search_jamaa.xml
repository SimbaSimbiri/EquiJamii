<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/backg_bottom"
    tools:context=".ui.main_activity.people_page.SearchJamaaFragment">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchViewAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/titleTab2"
        style="@style/Widget.AppCompat.SearchView"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        app:iconifiedByDefault="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:queryHint="Search for jamaa or leader"
        android:background="@drawable/shape_stroke_rectangle"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchPeopleRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchViewAll"
        tools:listitem="@layout/adapters_network_item" />

</androidx.constraintlayout.widget.ConstraintLayout>