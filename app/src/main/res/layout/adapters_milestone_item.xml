<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    app:cardCornerRadius="8dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/deleteMilestoneIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/cancel_fab_icon"
            android:visibility="gone"
            app:tint="@color/logoColour"
            android:layout_margin="5dp"
            app:layout_constraintBottom_toTopOf="@id/dueMilestoneTv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/textTaskMentionView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:textColor="@color/black"
            android:layout_margin="5dp"
            app:layout_constraintEnd_toStartOf="@id/deleteMilestoneIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dueMilestoneTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="italic"
            android:paddingBottom="5dp"
            android:textColor="@color/logoColour"
            android:layout_margin="5dp"
            android:paddingHorizontal="3dp"
            android:textSize="10sp"
            android:text="due by Monday"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <CheckBox
            android:id="@+id/checkBoxInProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/logoColour"
            app:layout_constraintTop_toBottomOf="@id/textTaskMentionView"
            android:text="in progress"
            android:buttonTint="@color/logoColour"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/checkBoxComplete"
            android:layout_width="wrap_content"
            android:buttonTint="@color/logoColour"
            android:layout_height="wrap_content"
            android:text="is complete"
            app:layout_constraintTop_toBottomOf="@id/textTaskMentionView"
            android:textColor="@color/logoColour"
            app:layout_constraintStart_toEndOf="@id/checkBoxInProgress"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
