<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backg_bottom"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main_activity.news_page.official_coms.DialogViewDocument">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewScroll"
        android:layout_width="25dp"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/logoColour"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.github.barteksc.pdfviewer.PDFView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="2dp"
        android:background="@drawable/shape_stroke_rectangle"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardViewScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/pdfViewer"/>

    <ProgressBar
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="visible"
        android:id="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:clickable="true"
        android:layout_width="40dp"
        android:contentDescription="Download pdf"
        android:layout_height="30dp"
        android:id="@+id/downloadPdf"
        android:src="@drawable/download_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>