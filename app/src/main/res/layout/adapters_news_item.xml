<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/cardItemSample"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:backgroundTint="@color/logoColour"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="5dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageViewHeadNews"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:contentDescription="@string/newsImages"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.333"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.023" />

        <TextView
            android:id="@+id/textViewHeadline"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@color/navColor"
            android:fontFamily="@font/baloo_paaji_2_semibold"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/imageViewHeadNews"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/imageViewHeadNews"
            app:layout_constraintTop_toTopOf="@id/imageViewHeadNews"
            app:layout_constraintVertical_bias="1.0" />

        <ImageView
            android:layout_width="24dp"
            android:id="@+id/editNews"
            android:padding="5dp"
            android:visibility="visible"
            android:background="@drawable/circle"
            android:layout_height="24dp"
            android:src="@drawable/add_news_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_margin="10dp"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>