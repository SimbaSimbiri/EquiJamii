<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/cardViewUserInNetwork"
    android:layout_marginHorizontal="3dp"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfileImage"
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:layout_margin="5dp"
            android:clickable="true"
            app:cardCornerRadius="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/profile"
                android:src="@drawable/good_profile" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textNameProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foregroundGravity="center_vertical"
            android:layout_marginHorizontal="5dp"
            android:text="Ray Simbiri"
            android:textColor="@color/logoColour"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toTopOf="@id/textDesignation"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardProfileImage"
            app:layout_constraintTop_toTopOf="@id/cardProfileImage" />

        <TextView
            android:id="@+id/textDesignation"
            android:layout_width="0dp"
            android:gravity="start"
            android:layout_marginTop="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="7dp"
            app:layout_constraintTop_toBottomOf="@id/textNameProfile"
            app:layout_constraintEnd_toStartOf="@id/messageUser"
            android:text="SWE at EquityJamii"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/cardProfileImage"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/messageUser"
            android:background="@drawable/shape_stroke_rectangle"
            android:text="Message"
            android:textColor="@color/logoColour"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="4dp"
            android:layout_margin="6dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>